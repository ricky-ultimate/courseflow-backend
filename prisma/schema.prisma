generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id               String    @id @default(cuid())
    matricNO         String    @unique
    email            String    @unique
    password         String
    name             String?
    role             Role      @default(STUDENT)
    isActive         Boolean   @default(true)
    lastLoginAt      DateTime?
    resetToken       String?   @unique
    resetTokenExpiry DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    complaints        Complaint[]
    verificationCodes VerificationCode[]
    managedDepartment Department?        @relation("DepartmentHOD")

    @@map("users")
}

model Department {
    id          String   @id @default(cuid())
    name        String
    code        String   @unique
    description String?  @db.Text
    hodId       String?  @unique
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    hod       User?      @relation("DepartmentHOD", fields: [hodId], references: [id], onDelete: SetNull)
    courses   Course[]
    lecturers Lecturer[]

    @@map("departments")
}

model Lecturer {
    id             String   @id @default(cuid())
    name           String
    email          String   @unique
    phone          String?
    departmentCode String
    isActive       Boolean  @default(true)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    department Department @relation(fields: [departmentCode], references: [code], onDelete: Cascade)
    courses    Course[]

    @@map("lecturers")
}

model Course {
    id             String   @id @default(cuid())
    code           String   @unique
    name           String
    overview       String?  @db.Text
    level          Level
    credits        Int      @default(2)
    semester       Semester @default(FIRST)
    departmentCode String
    lecturerId     String?
    isGeneral      Boolean  @default(false)
    isLocked       Boolean  @default(false)
    isActive       Boolean  @default(true)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    department    Department     @relation(fields: [departmentCode], references: [code], onDelete: Cascade)
    lecturer      Lecturer?      @relation(fields: [lecturerId], references: [id], onDelete: SetNull)
    schedules     Schedule[]
    examSchedules ExamSchedule[]

    @@map("courses")
}

model AcademicSession {
    id        String   @id @default(cuid())
    name      String   @unique
    startDate DateTime
    endDate   DateTime
    isActive  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    schedules     Schedule[]
    examSchedules ExamSchedule[]

    @@map("academic_sessions")
}

model Schedule {
    id         String    @id @default(cuid())
    courseCode String
    semester   Semester  @default(FIRST)
    sessionId  String
    dayOfWeek  DayOfWeek
    startTime  String
    endTime    String
    venue      String
    type       ClassType @default(LECTURE)
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    course  Course          @relation(fields: [courseCode], references: [code], onDelete: Cascade)
    session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@map("schedules")
}

model ExamSchedule {
    id           String   @id @default(cuid())
    courseCode   String
    date         DateTime
    startTime    String
    endTime      String
    venue        String
    invigilators String?
    semester     Semester
    sessionId    String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    course  Course          @relation(fields: [courseCode], references: [code], onDelete: Cascade)
    session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@map("exam_schedules")
}

model Complaint {
    id         String          @id @default(cuid())
    userId     String?
    name       String
    email      String
    department String
    subject    String
    message    String
    status     ComplaintStatus @default(PENDING)
    resolvedBy String?
    resolvedAt DateTime?
    createdAt  DateTime        @default(now())
    updatedAt  DateTime        @updatedAt

    user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@map("complaints")
}

model VerificationCode {
    id          String    @id @default(cuid())
    code        String    @unique
    role        Role
    description String?
    isActive    Boolean   @default(true)
    usageCount  Int       @default(0)
    maxUsage    Int?
    expiresAt   DateTime?
    createdBy   String
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

    @@map("verification_codes")
}

enum Role {
    STUDENT
    LECTURER
    ADMIN
}

enum Level {
    LEVEL_100
    LEVEL_200
    LEVEL_300
    LEVEL_400
    LEVEL_500
}

enum Semester {
    FIRST
    SECOND
}

enum DayOfWeek {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
    SUNDAY
}

enum ComplaintStatus {
    PENDING
    IN_PROGRESS
    RESOLVED
    CLOSED
}

enum ClassType {
    LECTURE
    SEMINAR
    LAB
    TUTORIAL
}
