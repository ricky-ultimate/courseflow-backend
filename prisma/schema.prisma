generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id               String    @id @default(cuid())
    matricNO         String    @unique
    email            String    @unique
    password         String
    name             String?
    role             Role      @default(STUDENT)
    phone            String?
    departmentCode   String?
    collegeCode      College?
    isActive         Boolean   @default(true)
    lastLoginAt      DateTime?
    resetToken       String?   @unique
    resetTokenExpiry DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    department        Department? @relation("LecturerDepartment", fields: [departmentCode], references: [code], onDelete: SetNull)
    managedDepartment Department? @relation("DepartmentHOD")
    taughtCourses     Course[]
    complaints        Complaint[]

    @@map("users")
}

model Department {
    id               String   @id @default(cuid())
    name             String
    code             String   @unique
    description      String?  @db.Text
    college          College  @default(CBAS)
    hodId            String?  @unique
    isActive         Boolean  @default(true)
    isScheduleLocked Boolean  @default(false)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    hod       User?    @relation("DepartmentHOD", fields: [hodId], references: [id], onDelete: SetNull)
    courses   Course[]
    lecturers User[]   @relation("LecturerDepartment")

    @@map("departments")
}

model Course {
    id             String   @id @default(cuid())
    code           String   @unique
    name           String
    overview       String?  @db.Text
    level          Level
    credits        Int      @default(2)
    semester       Semester @default(SECOND)
    departmentCode String
    lecturerId     String?
    isGeneral      Boolean  @default(false)
    isLocked       Boolean  @default(false)
    isActive       Boolean  @default(true)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    department     Department     @relation(fields: [departmentCode], references: [code], onDelete: Cascade)
    lecturer       User?          @relation(fields: [lecturerId], references: [id], onDelete: SetNull)
    schedules      Schedule[]
    examSchedules  ExamSchedule[]
    primaryAliases CourseAlias[]  @relation("PrimaryAliases")
    aliasOf        CourseAlias[]  @relation("AliasOf")

    @@map("courses")
}

model CourseAlias {
    id          String   @id @default(cuid())
    primaryCode String
    aliasCode   String
    createdAt   DateTime @default(now())

    primaryCourse Course @relation("PrimaryAliases", fields: [primaryCode], references: [code], onDelete: Cascade)
    aliasCourse   Course @relation("AliasOf", fields: [aliasCode], references: [code], onDelete: Cascade)

    @@unique([primaryCode, aliasCode])
    @@map("course_aliases")
}

model AcademicSession {
    id        String   @id @default(cuid())
    name      String   @unique
    startDate DateTime
    endDate   DateTime
    isActive  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    schedules     Schedule[]
    examSchedules ExamSchedule[]

    @@map("academic_sessions")
}

model Schedule {
    id               String    @id @default(cuid())
    courseCode       String
    semester         Semester  @default(SECOND)
    sessionId        String
    dayOfWeek        DayOfWeek
    startTime        String
    endTime          String
    isAutoGenerated  Boolean   @default(true)
    isManualOverride Boolean   @default(false)
    isFixed          Boolean   @default(false)
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    course  Course          @relation(fields: [courseCode], references: [code], onDelete: Cascade)
    session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@unique([courseCode, sessionId])
    @@map("schedules")
}

model ExamSchedule {
    id            String    @id @default(cuid())
    courseCode    String
    date          DateTime
    startTime     String
    endTime       String
    venue         VenueType
    studentCount  Int
    targetCollege College?
    invigilators  String?
    semester      Semester
    sessionId     String
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    course  Course          @relation(fields: [courseCode], references: [code], onDelete: Cascade)
    session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@unique([courseCode, sessionId])
    @@map("exam_schedules")
}

model Complaint {
    id         String          @id @default(cuid())
    userId     String?
    name       String
    email      String
    department String
    subject    String
    message    String
    status     ComplaintStatus @default(PENDING)
    resolvedBy String?
    resolvedAt DateTime?
    createdAt  DateTime        @default(now())
    updatedAt  DateTime        @updatedAt

    user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@map("complaints")
}

enum Role {
    STUDENT
    LECTURER
    HOD
    COLLEGE_ADMIN
    ADMIN
}

enum Level {
    LEVEL_100
    LEVEL_200
    LEVEL_300
    LEVEL_400
    LEVEL_500
}

enum Semester {
    FIRST
    SECOND
}

enum DayOfWeek {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
    SUNDAY
}

enum ComplaintStatus {
    PENDING
    IN_PROGRESS
    RESOLVED
    CLOSED
}

enum College {
    CBAS
    CHMS
    CAHS
}

enum VenueType {
    UNIVERSITY_ICT_CENTER
    ICT_LAB_1
    ICT_LAB_2

    LECTURE_HALL_1
    LECTURE_HALL_2
    LECTURE_HALL_3
    AUDITORIUM_A
    AUDITORIUM_B

    SEMINAR_ROOM_A
    SEMINAR_ROOM_B
    ROOM_101
    ROOM_102
    ROOM_201
    ROOM_202
    ROOM_301
    ROOM_302

    COMPUTER_LAB
    SCIENCE_LAB_1
    SCIENCE_LAB_2
}
